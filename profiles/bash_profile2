#!/bin/bash
############### bash_profile2 - Improved Version ###############
# Based on original bash_profile with modern enhancements

#========== OS Detection ==========
case "$(uname -s)" in
    Darwin*)    OS_TYPE="mac";;
    Linux*)     OS_TYPE="linux";;
    CYGWIN*)    OS_TYPE="cygwin";;
    MINGW*)     OS_TYPE="mingw";;
    *)          OS_TYPE="unknown";;
esac

#========== History Settings ==========
export HISTSIZE=10000                # Lines in memory
export HISTFILESIZE=20000            # Lines in file
export HISTCONTROL=ignoreboth:erasedups  # Ignore duplicates and spaces
export HISTTIMEFORMAT="%F %T "       # Add timestamps to history
shopt -s histappend                  # Append to history, don't overwrite

#========== Bash Options ==========
shopt -s checkwinsize                # Update LINES and COLUMNS after each command
shopt -s cmdhist                     # Save multi-line commands as one history entry
shopt -s cdspell                     # Autocorrect typos in cd commands
shopt -s dirspell 2>/dev/null        # Autocorrect directory names (bash 4+)
shopt -s nocaseglob                  # Case-insensitive globbing
shopt -s autocd 2>/dev/null          # cd without typing cd (bash 4+)

#========== Command Completion ==========
# Enable bash completion if available
if [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
elif [ -f /usr/local/etc/bash_completion ]; then
    . /usr/local/etc/bash_completion
fi

# Homebrew bash completion (macOS)
if [[ "$OS_TYPE" == "mac" ]] && [ -f "$(brew --prefix 2>/dev/null)/etc/bash_completion" ]; then
    . "$(brew --prefix)/etc/bash_completion"
fi

#========== Editor Settings ==========
export EDITOR=vim
export VISUAL=vim

#========== Color Definitions ==========
# Using \033 for better compatibility across terminals
# dark background: uppercase; light background: lowercase
gray='\033[0;30m'
GRAY='\033[1;30m'
red='\033[0;31m'
RED='\033[1;31m'
green='\033[0;32m'
GREEN='\033[1;32m'
yellow='\033[0;33m'
YELLOW='\033[1;33m'
blue='\033[0;34m'
BLUE='\033[1;34m'
cyan='\033[0;36m'
CYAN='\033[1;36m'
violet='\033[0;35m'
VIOLET='\033[1;35m'
white='\033[0;37m'
WHITE='\033[1;37m'
NC='\033[0m'  # No Color

#========== Git Branch Function ==========
parse_git_branch() {
    git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/ (\1)/'
}

# Check if current directory is dirty (has uncommitted changes)
parse_git_dirty() {
    [[ $(git status 2> /dev/null | tail -n1) != "nothing to commit, working tree clean" ]] && echo "*"
}

#========== Prompt (PS1) ==========
export PS1="\n${NC}[${blue}\\u${GRAY}@${red}\\h${NC}] ${NC}\\w ${GREEN}\$(parse_git_branch)${RED}\$(parse_git_dirty)${NC} \n\\$ "

#========== Basic Aliases ==========
alias shrug="echo \"¯\_(ツ)_/¯\""  # The most important alias

# Platform-specific ls aliases
if [[ "$OS_TYPE" == "mac" ]]; then
    alias ls="ls -G"
    alias lsa="ls -FlahG"
else
    alias ls="ls --color=auto"
    alias lsa="ls -Flah --color=auto"
fi

alias ll="ls -lh"
alias la="ls -A"
alias l="ls -CF"

# Grep with color
alias grep="grep --color=auto"
alias fgrep="fgrep --color=auto"
alias egrep="egrep --color=auto"

#========== Safety Aliases ==========
alias rm="rm -i"      # Confirm before removing
alias cp="cp -i"      # Confirm before overwriting
alias mv="mv -i"      # Confirm before overwriting
alias ln="ln -i"      # Confirm before overwriting

#========== Navigation Aliases ==========
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ~="cd ~"
alias -- -="cd -"     # Go back to previous directory

#========== Common Command Shortcuts ==========
alias h="history"
alias c="clear"
alias e="$EDITOR"
alias v="vim"

# Directory listing after cd
cd() {
    builtin cd "$@" && ls
}

#========== File & Directory Operations ==========
alias mkdir="mkdir -pv"   # Create parent dirs, verbose
alias tree="tree -C"      # Tree with color (if tree is installed)

#========== System Information ==========
alias df="df -h"          # Human-readable sizes
alias du="du -h"          # Human-readable sizes
alias free="free -h 2>/dev/null || echo 'free command not available'"  # Linux only

#========== Network ==========
alias ping="ping -c 5"    # Ping 5 times by default
alias ports="netstat -tulanp 2>/dev/null || ss -tulanp 2>/dev/null"

#========== Git Aliases ==========
alias gs="git status"
alias ga="git add"
alias gc="git commit"
alias gp="git push"
alias gl="git log --oneline --graph --decorate"
alias gd="git diff"
alias gb="git branch"
alias gco="git checkout"
alias gpull="git pull"

#========== Useful Functions ==========

# Create directory and cd into it
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Extract various archive types
extract() {
    if [ -f "$1" ] ; then
        case "$1" in
            *.tar.bz2)   tar xjf "$1"     ;;
            *.tar.gz)    tar xzf "$1"     ;;
            *.bz2)       bunzip2 "$1"     ;;
            *.rar)       unrar x "$1"     ;;
            *.gz)        gunzip "$1"      ;;
            *.tar)       tar xf "$1"      ;;
            *.tbz2)      tar xjf "$1"     ;;
            *.tgz)       tar xzf "$1"     ;;
            *.zip)       unzip "$1"       ;;
            *.Z)         uncompress "$1"  ;;
            *.7z)        7z x "$1"        ;;
            *)           echo "'$1' cannot be extracted via extract()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# Find file by name
ff() {
    find . -type f -iname "*$1*"
}

# Find directory by name
fd() {
    find . -type d -iname "*$1*"
}

# Search for text in files
search() {
    grep -r -i "$1" .
}

# Show disk usage of current directory
diskuse() {
    du -sh ./* | sort -hr
}

# Show most used commands
topcommands() {
    history | awk '{print $2}' | sort | uniq -c | sort -rn | head -10
}

# Weather function (requires curl)
weather() {
    curl -s "wttr.in/${1:-}"
}

# Quick backup of a file
backup() {
    cp "$1" "$1.backup-$(date +%Y%m%d-%H%M%S)"
}

#========== PATH Management ==========
# Add common directories to PATH if they exist
pathappend() {
    if [ -d "$1" ] && [[ ":$PATH:" != *":$1:"* ]]; then
        PATH="${PATH:+"$PATH:"}$1"
    fi
}

pathprepend() {
    if [ -d "$1" ] && [[ ":$PATH:" != *":$1:"* ]]; then
        PATH="$1${PATH:+":$PATH"}"
    fi
}

# Add local bin directories if they exist
pathprepend "$HOME/.local/bin"
pathprepend "$HOME/bin"

export PATH

#========== Welcome Message ==========
# Show system info on login (optional - comment out if not desired)
if [ -f /usr/bin/neofetch ] || [ -f /usr/local/bin/neofetch ]; then
    : # neofetch  # Uncomment to show system info
fi

#========== Source Local Customizations ==========
# Allow local machine-specific customizations without modifying this file
if [ -f ~/.bash_profile_local ]; then
    . ~/.bash_profile_local
fi
